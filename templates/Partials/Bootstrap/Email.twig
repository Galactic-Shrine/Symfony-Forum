{% set SiteName = GetConfig('Name') %}

<!DOCTYPE html>
<html>
  <head>
		<meta charset="UTF-8">
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		{% block meta %}
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		{% endblock %}
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		{% block javascripts %}
			{% block importmap %}
				{{ importmap(['bootstrap.css', 'App-Bootstrap.css']) }}
			{% endblock %}
		{% endblock %}
  </head>
	<body class="bg-dark">
	  <main class="container">
			{% block body %}{% endblock %}
			{% block footer %}{#
			<img class="ax-center mt-10 w-40" src="{{ absolute_url(asset('Images/Logo/1.3.2.png')) }}" />
			<div class="text-muted text-center my-6">
			  Sent with <3 from Hip Corp. <br>
			  Hip Corp. 1 Hip Street<br>
			  Gnarly State, 01234 USA <br>
			</div>#}
			{% endblock %}
	  </main>
		<footer class="footer mt-auto d-flex flex-wrap justify-content-between align-items-center py-3 bg-dark">
			<section class="col-md-7 d-flex align-items-center">
				<span class="ms-3">
					© 2019-{{ "now"|date("Y") }}, {{ SiteName }} - {{ "Text.Footer.Copyright" | trans }}
				</span>
			</section>
		</footer>
	</body>
</html>