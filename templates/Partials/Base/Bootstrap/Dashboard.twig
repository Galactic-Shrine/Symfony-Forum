{% set SiteName = GetConfig('Name') %}
{% set ColorVersion = GetConfig('Theme') %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-100" data-bs-theme="{{ ColorVersion }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %} :: {{ SiteName }}</title>
{% block meta %}
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% endblock %}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
{% block stylesheets %}{% endblock %}
{% block javascripts %}
	{% block importmap %}
		{{ importmap(['DashboardBootstrap']) }}
	{% endblock %}
{% endblock %}

    </head>
    <body class="d-flex flex-column h-100">
      <header class="navbar sticky-top bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="dark">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white" href="{{ absolute_url(path('admin_dashboard_index')) }}">{{ SiteName }}</a>
      </header>
      <main class="container-fluid h-100">
        <section class="row h-100">
          <nav class="sidebar border border-right col-md-3 col-lg-2 p-0 bg-body-tertiary h-100">
            <section class="offcanvas-md offcanvas-end bg-body-tertiary" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
              <section class="offcanvas-body d-md-flex flex-column p-0 pt-lg-3 overflow-y-auto">
                <ul class="nav flex-column">
                  <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2" aria-current="page" href="{{ absolute_url(path('index')) }}">
                      <svg class="bi"><use xlink:href="#house-fill"/></svg>
                      {{ "Back.To.Website" | trans({}, 'Dashboard') }}
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2" href="{{ absolute_url(path('admin_category_index')) }}">
                      <svg class="bi"><use xlink:href="#tag"/></svg>
                      {{ "Category" | trans({}, 'Dashboard') }}
                    </a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2" href="#">
                      <svg class="bi"><use xlink:href="#people"/></svg>
                      {{ "User" | trans({}, 'Dashboard') }}
                    </a>
                  </li>
                </ul>
                <!--<h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-body-secondary text-uppercase">
                  <span>
                    <svg class="bi"><use xlink:href="#people"/></svg> User
                  </span>
                </h6>
                <hr class="my-3">-->
              </section>
            </section>
          </nav>
          <section class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  {% block breadcrumb %}
                  <li class="breadcrumb-item"><a href="{{ absolute_url(path('admin_dashboard_index')) }}">{{ "Dashboard" | trans({}, 'Dashboard') }}</a></li>
                  {% endblock %}
                </ol>
              </nav>
            </div>

{% block body %}
{% endblock %}
        </section>
      </section>
    </main>
    {% include '@Default/Svg.twig' %}
	</body>
</html>
