{# On Includ le template de base #}
{% extends '@Bootstrap/Site.twig' %}

{% block title %}{{ "Title.ResetYourPassword" | trans({}, 'OAuth') }}{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    {{ form_start(requestForm) }}
    <section class="row justify-content-center mt-5">
        <section class="card text-bg-secondary" style="max-width: 45rem;">
            <section class="card-body">
                <header class="card-title">
                    <h5 class="card-title">{{ "Title.ResetYourPassword" | trans({}, 'OAuth') }}</h5>
                </header>
                <main class="card-text">
                        <small>
                            {{ "Text.Reset.EnterYourEmailAddress" | trans({}, 'OAuth') }}
                        </small>
                        {{ form_row(requestForm.Email, { 
                            attr: {
                                class: 'form-control rounded-3 mt-1'
                            }
                        }) }}
                </main>
                <footer>
                    <hr class="my-3">
                    <button class="btn btn-primary" style="width: 100%">{{ "Button.SendPasswordResetEmail" | trans({}, 'OAuth') }}</button>
                </footer>
            </section>
        </section>
    </section>
    {{ form_end(requestForm) }}
{% endblock %}
