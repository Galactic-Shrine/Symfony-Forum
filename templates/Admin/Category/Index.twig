{% extends '@Bootstrap/Dashboard.twig' %}

{% block title %}{{ "Title.AdminCategory" | trans({}, 'Dashboard') }}{% endblock %}

{% block breadcrumb %}
{{ parent() }}<li class="breadcrumb-item active" aria-current="page">{{ "Text.Category" | trans({}, 'Dashboard') }}</li>
{% endblock %}

{% block body %}

	<a href="{{ path('admin_category_new') }}" class="btn btn-sm btn-primary mb-3">{{ "Button.Create.New.Category" | trans({}, 'Dashboard') }}</a>
	<table class="table table-striped">
		<thead>
			<tr>
				<th scope="col">{{ "Table.Name" | trans({}, 'Dashboard') }}</th>
				<th scope="col">{{ "Table.Description" | trans({}, 'Dashboard') }}</th>
				<th scope="col">{{ "Table.Controllers" | trans({}, 'Dashboard') }}</th>
				<th scope="col">{{ "Table.Order" | trans({}, 'Dashboard') }}</th>
				<th scope="col">{{ "Table.Actions" | trans({}, 'Dashboard') }}</th>
			</tr>
		</thead>
		<tbody>
			{% for Category in categories %}
			<tr>
				{% if Category is empty %}
				<td scope="row" colspan="5">{{ "Category.Empty" | trans({}, 'Dashboard') }}</td>
				
				{% else %}
				<td scope="row">{{ Category.Name }}</td>
				<td>{{ Category.Description }}</td>
				<td>{{ Category.Controllers | join(', ') | trans({}, 'Dashboard') }}</td>
				<td>{{ Category.Position }}</td>
				<td>
					<a href="{{ path('admin_category_edit', { id: Category.Id }) }}" class="btn btn-sm btn-warning">{{ "Button.Edit" | trans({}, 'Dashboard') }}</a>
					<form method="post" action="{{ path('admin_category_delete', { id: Category.Id }) }}" style="display:inline;" onsubmit="return confirm('Confirmer la suppression ?');">
						<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ Category.Id) }}">
						<button type="submit" class="btn btn-sm btn-danger">{{ "Button.Delete" | trans({}, 'Dashboard') }}</button>
					</form>
				</td>
				{% endif %}
			</tr>
			{% endfor %}
		</tbody>
	</table>
	<a href="{{ path('admin_category_new') }}" class="btn btn-sm btn-primary mt-3">{{ "Button.Create.New.Category" | trans({}, 'Dashboard') }}</a>
{% endblock %}
